<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Torneo4vs4.Views.Scorers.ScorersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Torneo4vs4.ViewModels"
    Title="Marcatori"
    BackgroundColor="#F4F4F4">

    <Grid
        Padding="12"
        RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- TITOLO -->
        <Label
            Grid.Row="0"
            Text="MARCATORI"
            FontSize="30"
            FontAttributes="Bold"
            Margin="4,10,4,16" />

        <!-- CARICAMENTO -->
        <ActivityIndicator
            Grid.Row="1"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            HorizontalOptions="Center"
            Margin="0,0,0,10" />

        <!-- INTESTAZIONE -->
        <Border
            Grid.Row="2"
            BackgroundColor="#E8E8E8"
            StrokeThickness="0"
            Padding="8,12">

            <Grid
                ColumnDefinitions="*,85,48,48,52"
                ColumnSpacing="2">

                <Label
                    Grid.Column="0"
                    Text="Giocatore"
                    FontAttributes="Bold"
                    VerticalTextAlignment="Center" />

                <Label
                    Grid.Column="1"
                    Text="Squadra"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center" />

                <Label
                    Grid.Column="2"
                    Text="Pres."
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center" />

                <Label
                    Grid.Column="3"
                    Text="Gol"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center" />

                <Label
                    Grid.Column="4"
                    Text="Assist"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center" />

            </Grid>

        </Border>

        <!-- GIOCATORI -->
        <CollectionView
            Grid.Row="3"
            ItemsSource="{Binding Players}"
            SelectionMode="None">

            <CollectionView.ItemTemplate>

                <DataTemplate
                    x:DataType="viewModels:ScorerRowViewModel">

                    <Border
                        BackgroundColor="White"
                        Stroke="#E0E0E0"
                        StrokeThickness="1"
                        Padding="8,12">

                        <Grid
                            ColumnDefinitions="*,85,48,48,52"
                            ColumnSpacing="2">

                            <!-- GIOCATORE -->
                            <Label
                                Grid.Column="0"
                                Text="{Binding PlayerName}"
                                FontAttributes="Bold"
                                LineBreakMode="TailTruncation"
                                VerticalTextAlignment="Center" />

                            <!-- SQUADRA -->
                            <Label
                                Grid.Column="1"
                                Text="{Binding TeamName}"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"
                                LineBreakMode="TailTruncation" />

                            <!-- PRESENZE -->
                            <Label
                                Grid.Column="2"
                                Text="{Binding Appearances}"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                            <!-- GOL -->
                            <Label
                                Grid.Column="3"
                                Text="{Binding Goals}"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                            <!-- ASSIST -->
                            <Label
                                Grid.Column="4"
                                Text="{Binding Assists}"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- ERRORE -->
        <Border
            Grid.Row="4"
            IsVisible="{Binding HasError}"
            BackgroundColor="#FFF0F0"
            Stroke="#D00000"
            StrokeThickness="1"
            Padding="15"
            Margin="0,10,0,0">

            <Label
                Text="{Binding ErrorMessage}"
                TextColor="#A00000" />

        </Border>

    </Grid>

</ContentPage>