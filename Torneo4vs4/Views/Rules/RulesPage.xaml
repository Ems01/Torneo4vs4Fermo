<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Torneo4vs4.Views.Rules.RulesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Torneo4vs4.Models"
    Title="Regolamento"
    BackgroundColor="#F4F4F4">

    <Grid
        Padding="12"
        RowDefinitions="Auto,Auto,*,Auto">

        <Label
            Grid.Row="0"
            Text="REGOLAMENTO"
            FontSize="30"
            FontAttributes="Bold"
            Margin="4,10,4,16" />

        <ActivityIndicator
            Grid.Row="1"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            HorizontalOptions="Center"
            Margin="0,0,0,10" />

        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Rules}"
            SelectionMode="None">

            <CollectionView.ItemTemplate>

                <DataTemplate
                    x:DataType="models:RuleSection">

                    <Border
                        BackgroundColor="White"
                        Stroke="#E0E0E0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="16"
                        Margin="0,0,0,12">

                        <VerticalStackLayout
                            Spacing="10">

                            <Label
                                Text="{Binding Title}"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="#222222" />

                            <Label
                                Text="{Binding Content}"
                                FontSize="15"
                                LineHeight="1.25"
                                TextColor="#444444" />

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <Border
            Grid.Row="3"
            IsVisible="{Binding HasError}"
            BackgroundColor="#FFF0F0"
            Stroke="#D00000"
            StrokeThickness="1"
            Padding="15"
            Margin="0,10,0,0">

            <Label
                Text="{Binding ErrorMessage}"
                TextColor="#A00000" />

        </Border>

    </Grid>

</ContentPage>